# --- SUPABASE CONFIGURATION ---
# Obtén estos valores en Settings > API de tu panel de Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Deep links de Auth (confirmar correo, recuperar contraseña).
# 1) Deben coincidir con el scheme/host en android/app/src/main/AndroidManifest.xml
#    (intent-filter) y en iOS Runner/Info.plist (CFBundleURLSchemes).
# 2) En Supabase: Authentication → URL Configuration → Redirect URLs, añade EXACTAMENTE:
#    - ${AUTH_REDIRECT_LOGIN}
#    - ${AUTH_REDIRECT_RESET_PASSWORD}
#    (y la Site URL puede ser la web o el mismo esquema de la app según tu despliegue).
AUTH_DEEP_LINK_SCHEME=com.marco.myteam
AUTH_REDIRECT_LOGIN=com.marco.myteam://login
AUTH_REDIRECT_RESET_PASSWORD=com.marco.myteam://reset-password

# --- APP CONFIGURATION ---
# Opcional: Define el entorno (development, production)
APP_ENVIRONMENT=development
APP_NAME="Mi App de Fútbol"

